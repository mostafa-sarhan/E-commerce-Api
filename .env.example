# Server-side secrets. Never commit a real key.

# --- AI assistant ---
# The AI assistant reads OPENROUTER_API_KEY in the Vercel function at
# api/chat.js - it is deliberately not a VITE_* variable, because Vite
# inlines anything prefixed VITE_ into the public browser bundle.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PUBLIC_SITE_URL=

# --- Admin test account (local development only) ---
# The Route API this storefront uses is customer-only and cannot
# authenticate an admin, so admin screens are reached through the local
# test endpoint instead. It answers 404 unless ENABLE_DEV_ADMIN_LOGIN is
# exactly "true", so a deployment that does not opt in has no admin login.
ENABLE_DEV_ADMIN_LOGIN=
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
